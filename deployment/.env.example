# Copy this file to deployment/.env and fill in the values.
# NEVER commit the real .env file. Use a TEST-ONLY wallet with no real funds.

# Private key of the deployer/owner test wallet (0x...)
PRIVATE_KEY=

# Optional: custom BSC Testnet RPC (defaults to the public BNB Chain endpoint)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Etherscan API v2 key (works for testnet.bscscan.com verification)
ETHERSCAN_API_KEY=

# Pinata JWT used to pin the image and metadata on IPFS
PINATA_JWT=
